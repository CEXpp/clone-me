# Copy to .env; scripts/dev.ps1 loads it as plain key=value data (no shell execution).
# Real secrets belong only in .env or the process environment.
CLONE_DATA_DIR=./data
CLONE_BIND_ADDRESS=127.0.0.1
CLONE_SECURE_COOKIES=false
PORT=8080
CLONE_MASTER_KEY=

# One-time local administrator enrollment only. Remove the password after enrollment.
CLONE_ADMIN_USERNAME=owner
CLONE_ADMIN_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Set current CNY per million tokens. -1 deliberately blocks paid calls.
# Use a conservative cache-miss/peak price and currency conversion if applicable.
DEEPSEEK_INPUT_CNY_PER_MILLION=-1
DEEPSEEK_OUTPUT_CNY_PER_MILLION=-1

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

DECISION_PROVIDER=disabled
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_INPUT_CNY_PER_MILLION=-1
DASHSCOPE_API_KEY=
# Full workspace endpoint, ending in /compatible-mode/v1/systemone.
BAILIAN_DECISION_URL=
BAILIAN_INPUT_CNY_PER_MILLION=-1

CLONE_LOG_FILE=./logs/clone-me.jsonl
CLONE_NOTIFY_EMAIL=
CLONE_MAIL_FROM=
# Spring Boot mail configuration; omit host until mail is configured.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAME=jujube.cyou
