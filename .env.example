# 复制为 .env；开发脚本只把 KEY=value 当作数据读取，不执行其中的命令。
# 真实密钥只放本机 .env 或进程环境变量；此模板不能填写后提交。

# 资料与数据库目录；相对目录按 Java 进程工作目录解析，IDEA 建议固定为 backend。
CLONE_DATA_DIR=./data
CLONE_BIND_ADDRESS=127.0.0.1
CLONE_SECURE_COOKIES=false
PORT=8080
# 教学流程日志：本地默认 DEBUG，生产默认 INFO；需要减少输出时设置 INFO。
# CLONE_FLOW_LOG_LEVEL=DEBUG
# 主密钥是三十二字节的 Base64 编码，由 MasterKey 命令生成，用于加密动态口令秘密。
CLONE_MASTER_KEY=

# 以下账号密码仅用于本地初始化；创建成功后移除明文密码，主密钥仍须保留。
CLONE_ADMIN_USERNAME=owner
CLONE_ADMIN_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 单价单位是人民币元／每百万词元；默认 -1 表示未配置，主动阻止无法核算的付费调用。
# 按账户现行的保守未命中缓存／高峰价格填写，美元报价须先换算人民币。
DEEPSEEK_INPUT_CNY_PER_MILLION=-1
DEEPSEEK_OUTPUT_CNY_PER_MILLION=-1

# 免费模型也需要供应商密钥；模型固定为 BAAI/bge-m3，不能自动切到收费版本。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 专用重排默认复用上面的密钥与地址，使用免费 BAAI/bge-reranker-v2-m3。
# 按需取消注释；更换收费模型前，填写每百万输入 token 的人民币单价。
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_INPUT_CNY_PER_MILLION=-1

# 可选 disabled、typesafe、bailian；管理台可热切换，服务异常会记录并回退基础 RAG。
DECISION_PROVIDER=disabled
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_INPUT_CNY_PER_MILLION=-1
DASHSCOPE_API_KEY=
# 百炼需填写包含自己工作空间标识的完整地址，结尾为 /compatible-mode/v1/systemone。
BAILIAN_DECISION_URL=
BAILIAN_INPUT_CNY_PER_MILLION=-1

# JSON 日志按文件大小和保留期轮转，避免小磁盘被持续写满。
CLONE_LOG_FILE=./logs/clone-me.jsonl
CLONE_NOTIFY_EMAIL=
CLONE_MAIL_FROM=
# 以下为邮件配置示例；配置前保持注释，启用时移除需要项目的注释符并填入实际值。
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# 风险验证的秘密仅后端使用；站点标识可给前端，主机名必须与实际访问域名匹配。
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAME=jujube.cyou
