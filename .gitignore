# 密钥和私人运行数据，禁止提交到仓库
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-secrets.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.db
*.db-*
*.sqlite*
data/
runtime/
uploads/
backups/
logs/
*.log
.cache/

# 构建产物、依赖与编辑器临时文件
target/
**/target/
node_modules/
dist/
.idea/
.vscode/
*.iml
.DS_Store

# 仅供本机测试的配置
*.local
deploy/.release.env*
deploy/.previous.env
deploy/.images.env*
**/test-results/
**/playwright-report/
eval/private/

# 文档仅在本机整理；已有受跟踪文档也须在提交时显式排除。
docs/
**/previews/

# 本地评测产物与 Python 缓存
eval/runs/
__pycache__/
*.pyc
