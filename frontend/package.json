{
  "name": "clone-me-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "format:check": "prettier --check src public *.ts *.js *.json index.html",
    "format": "prettier --write src public *.ts *.js *.json index.html",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "autoprefixer": "10.4.21",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
