# 私有配置：复制为 deploy/.env，权限设为 600；不能提交真实值。
CLONE_DOMAIN=jujube.cyou
CLONE_DATA_HOST=/srv/clone-me/data
CLONE_CERT_HOST=/srv/clone-me/certificates
CLONE_ACME_HOST=/srv/clone-me/acme
CLONE_TLS_MODE=https
CLONE_PRODUCTION=true
CLONE_SECURE_COOKIES=true
CLONE_CHAT_ENABLED=false
CLONE_MASTER_KEY=
# 地址与 Compose 专用 Nginx IP 一致；不要放宽为信任所有代理。
CLONE_TRUSTED_PROXY_REGEX=172\.30\.23\.2

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_CNY_PER_MILLION=-1
DEEPSEEK_OUTPUT_CNY_PER_MILLION=-1
SILICONFLOW_API_KEY=
DECISION_PROVIDER=disabled
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAME=jujube.cyou
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
CLONE_MAIL_FROM=
CLONE_NOTIFY_EMAIL=
CLONE_MIN_FREE_DISK_MB=256
CLONE_MAX_DATABASE_MB=256
CLONE_MAX_SOURCES=200
CLONE_MAX_SOURCE_MB=200
CLONE_MAX_QUEUED_JOBS=32
CLONE_MAX_ACTIVE_RECORDS=3000
CLONE_MAX_RELEASES=20
