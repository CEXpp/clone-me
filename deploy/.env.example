# Clone Me 生产环境变量模板
# 已有部署在服务器上编辑 /srv/clone-me/runtime/deploy/.env，参考同目录的本模板。
# 新部署用本模板生成 .env 后设权限 600。真实密钥只填进服务器 .env。
# 当前腾讯云实例的公网域名 jujube.cyou 由共享 Nginx 管理。
# 内部 HTTPS 入口使用 CLONE_DOMAIN=localhost、CLONE_PRIVATE_INGRESS=true。

# 一、入口和持久化目录
CLONE_DOMAIN=example.com
# 通过 SSH 隧道访问时设为 true，并将 CLONE_DOMAIN 设为 localhost。
CLONE_PRIVATE_INGRESS=false
CLONE_DATA_HOST=/srv/clone-me/data
CLONE_CERT_HOST=/srv/clone-me/certificates
CLONE_ACME_HOST=/srv/clone-me/acme
CLONE_TLS_MODE=https
CLONE_PRODUCTION=true
CLONE_SECURE_COOKIES=true
# 安装时由脚本生成。更新或恢复现有数据时保留原主密钥。
CLONE_MASTER_KEY=
# 地址与 Compose 专用 Nginx IP 一致；不要放宽为信任所有代理。
CLONE_TRUSTED_PROXY_REGEX='172\.30\.23\.2'

# 二、访客 AI 问答。填完 DeepSeek、计费单价与 SMTP 并验证后，再将开关改为 true。
CLONE_CHAT_ENABLED=false
# 从 DeepSeek 开放平台复制 API Key。模型填写该账号实际开通的模型标识。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 金额单位为人民币元／每百万 token。按所选模型当前官方价格填写；-1 表示还没配置。
DEEPSEEK_INPUT_CNY_PER_MILLION=-1
DEEPSEEK_OUTPUT_CNY_PER_MILLION=-1

# 三、可选的语义索引与重排。需要为知识笔记使用向量检索时填写硅基流动 API Key。
SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 重排默认复用硅基流动；有独立供应商时再填写这组可选变量。
# RERANK_API_KEY=
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_INPUT_CNY_PER_MILLION=-1
DECISION_PROVIDER=disabled

# 四、SMTP 通知。询问邮箱服务商 SMTP 主机、端口与应用授权码。
# 587 与下方 STARTTLS 示例配套。示例主机 smtp.example.com，换成供应商的实际地址。
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
# 登录账号通常是完整邮箱地址，密码通常是 SMTP 授权码或应用专用密码。
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# 发件地址需符合服务商规则。收件地址填实际接收用量告警的邮箱。
CLONE_MAIL_FROM=
CLONE_NOTIFY_EMAIL=

# 五、可选的 Turnstile 验证。启用时同时填写站点密钥和服务端秘密。
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# 当前公网环境使用 jujube.cyou；新部署填写实际访问的域名。
TURNSTILE_HOSTNAME=example.com

# 六、运行容量限制。按磁盘与业务规模调整。
CLONE_MIN_FREE_DISK_MB=256
CLONE_MAX_DATABASE_MB=256
CLONE_MAX_SOURCES=200
CLONE_MAX_SOURCE_MB=200
CLONE_MAX_QUEUED_JOBS=32
CLONE_MAX_ACTIVE_RECORDS=3000
CLONE_MAX_RELEASES=20
